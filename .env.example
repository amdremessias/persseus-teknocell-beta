# Database
POSTGRES_DB=teknos_crm
POSTGRES_USER=teknos
POSTGRES_PASSWORD=change_me_secure_password

# Redis
REDIS_PASSWORD=change_me_redis_password

# JWT
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_EXPIRES_IN=8h

# Node
NODE_ENV=production

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514

# WhatsApp / MercadoPhone
MERCADOPHONE_URL=https://exclusivoapi.mercadophone.tech/api/messages/sendOfficialData
MERCADOPHONE_TOKEN=
OUTGOING_WEBHOOK_URL=https://mercadophone.com/api/send
OUTGOING_WEBHOOK_SECRET=

# Meta (Instagram / Messenger)
META_APP_SECRET=          # usado para validar X-Hub-Signature-256 dos webhooks Meta
META_VERIFY_TOKEN=change_me_meta_token   # token de verificação do challenge Meta
META_GRAPH_TOKEN=         # page access token para envio via Graph API

# BIA / n8n
N8N_BIA_URL=https://n8n.teknoscel.shop/webhook/bia-processar
BIA_SECRET=change_me_bia_secret   # segredo compartilhado: CRM ↔ n8n callback

# Web Push / PWA notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# URLs
FRONTEND_URL=https://crm.teknoscel.shop
NEXT_PUBLIC_API_URL=https://crm.teknoscel.shop/api
NEXT_PUBLIC_WS_URL=wss://crm.teknoscel.shop
