# ── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/teknos_crm

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=troque-por-segredo-seguro

# ── MercadoPhone (WhatsApp BSP) ───────────────────────────────────────────────
# Número de telefone da conta oficial (usado como token de autenticação)
MERCADOPHONE_TOKEN=5514996061006
MERCADOPHONE_URL=https://exclusivoapi.mercadophone.tech/api/messages/sendOfficialData
# Secret que o MercadoPhone envia no header X-Webhook-Secret (opcional mas recomendado)
OUTGOING_WEBHOOK_SECRET=

# ── BIA (IA Assistente) ───────────────────────────────────────────────────────
# observer = persiste mensagens mas NÃO responde automaticamente (padrão seguro)
# active   = persiste E dispara BIA — ativar só após validação completa
BIA_MODE=observer

# URL do webhook n8n que recebe as mensagens para processamento da BIA
BIA_WEBHOOK_URL=https://n8n.teknoscel.shop/webhook/bia-processar

# Secret enviado no header X-Bia-Secret (obrigatório em produção)
BIA_SECRET=troque-por-segredo-seguro

# Delay para agrupar mensagens consecutivas antes de acionar a BIA (ms)
BIA_GROUPING_DELAY_MS=8000

# Delay entre cada mensagem de resposta da BIA (ms)
BIA_INTER_MESSAGE_DELAY_MS=2000

# ── Meta (Instagram / Messenger) ─────────────────────────────────────────────
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# ── Site Quiz (endpoint /api/leads/from-site-quiz) ───────────────────────────
# Secret enviado pelo quiz do site no header X-Site-Secret
SITE_QUIZ_SECRET=troque-por-segredo-seguro

# ── Redis (opcional — para filas futuras) ────────────────────────────────────
REDIS_URL=redis://localhost:6379
