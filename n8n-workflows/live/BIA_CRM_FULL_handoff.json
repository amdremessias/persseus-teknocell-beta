                "jsCode": "// Atendente de assistencia (desvio fixo)\nconst ASSIST_AGENTE_ID = 'cmpy2xf9d00yt14nyuv5yyk7n';\nconst ASSIST_AGENTE_NOME = 'Diego';\nconst resp = $input.item.json ?? {};\nconst ag = resp.agente ?? resp.agent ?? resp.data ?? resp;\nlet agente_id = ag.id ?? ag.agente_id ?? ag.userId ?? null;\nlet agente_nome = ag.nome ?? ag.name ?? ag.agente_nome ?? null;\n\n// auto-assign DESLIGADO \u2014 handoff cai sem dono, atendente pega manual\nagente_id = null;\nagente_nome = null;\n\nconst wb = $('webhook_handoff').item.json.body ?? $('webhook_handoff').item.json;\nconst metadata = wb.metadata ?? {};\nconst txt = [metadata.intencao, metadata.resumo, wb.handoff_reason]\n  .filter(Boolean).join(' ').toLowerCase();\nconst ASSIST_KW = ['assist','conserto','reparo','quebr','trinc','molh',\n  'nao liga','n\u00e3o liga','nao carrega','n\u00e3o carrega','troca de tela','tela quebrada','display'];\nconst is_assistencia = ASSIST_KW.some(k => txt.includes(k));\n// desvio do Diego desligado \u2014 assistencia tambem cai sem dono\n// if (is_assistencia) {\n//   agente_id = ASSIST_AGENTE_ID;\n//   agente_nome = ASSIST_AGENTE_NOME;\n// }\n\nreturn {\n  json: {\n    lead_id: wb.lead_id,\n    lead_nome: wb.lead_nome ?? null,\n    lead_telefone: wb.lead_telefone ?? null,\n    handoff_reason: wb.handoff_reason ?? 'lead_quente',\n    metadata,\n    agente_id,\n    agente_nome,\n    is_assistencia,\n    timestamp: new Date().toISOString()\n  }\n};"
