# Template dos segredos do deploy. Copie para .env.deploy e preencha.
#   cp .env.deploy.example .env.deploy && edite os valores
# .env.deploy é gitignored — nunca versione os segredos reais.
POSTGRES_PASSWORD=""
REDIS_PASSWORD=""
JWT_SECRET=""
ANTHROPIC_API_KEY="sk-ant-..."
MERCADOPHONE_TOKEN=""
OUTGOING_WEBHOOK_SECRET=""
META_VERIFY_TOKEN=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
BIA_SECRET=""
# IP do admin (casa/escritório) que o fail2ban NUNCA deve banir — evita
# travar deploys por timeout no SSH. Descubra o seu com: curl ifconfig.me
# Deixe vazio pra não aplicar nenhum ignoreip extra (só loopback).
ADMIN_IP="203.0.113.10"  # exemplo — troque pelo seu IP real
# URLs dos sistemas externos "Bia Vendas" (links no menu, abrem em nova aba).
# Precisam do prefixo NEXT_PUBLIC_ pra serem lidas no build do frontend.
NEXT_PUBLIC_BIA_VENDAS_URL="http://IP:PORTA"          # loja/LAN, ex: http://192.168.1.50:8080
NEXT_PUBLIC_BIA_VENDAS_REMOTO_URL="http://IP:PORTA"   # remoto/Tailscale, ex: http://100.82.152.83:8080
